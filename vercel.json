{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "natermanufacture.com" }],
      "destination": "https://www.natermanufacture.com/$1",
      "statusCode": 308
    },
    {
      "source": "/",
      "destination": "/en/",
      "statusCode": 308
    },
    {
      "source": "/:locale/products/mounted-spherical-roller-bearings/:path*",
      "destination": "/:locale/products/:path*",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/bearings/:path*",
      "destination": "/:locale/products/:path*",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/bearing-housing/:path*",
      "destination": "/:locale/products/bearing-housing-series/",
      "statusCode": 301
    },
    {
      "source": "/:locale/about-us/:path*",
      "destination": "/:locale/",
      "statusCode": 301
    }
  ]
}
