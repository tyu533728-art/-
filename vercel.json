{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)\\.(webp|avif|png|jpg|jpeg|svg|ico)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/assets/(.*)\\.(css|js)$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)\\.xlsx$",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "natermanufacture.com" }],
      "destination": "https://www.natermanufacture.com/$1",
      "statusCode": 308
    },
    {
      "source": "/",
      "destination": "/en/",
      "statusCode": 308
    },
    {
      "source": "/:locale/products/mounted-spherical-roller-bearings",
      "destination": "/:locale/products/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/mounted-spherical-roller-bearings/(.*)",
      "destination": "/:locale/products/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/bearings",
      "destination": "/:locale/products/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/bearings/(.*)",
      "destination": "/:locale/products/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/bearing-housing",
      "destination": "/:locale/products/bearing-housing-series/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/bearing-housing/(.*)",
      "destination": "/:locale/products/bearing-housing-series/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/bearing-housing-series/pbh",
      "destination": "/:locale/products/bearing-housing-series/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/bearing-housing-series/pbh/(.*)",
      "destination": "/:locale/products/bearing-housing-series/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/pillow-block-bearing-units/mbu",
      "destination": "/:locale/products/pillow-block-bearing-units/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/pillow-block-bearing-units/mbu/(.*)",
      "destination": "/:locale/products/pillow-block-bearing-units/",
      "statusCode": 301
    },
    {
      "source": "/:locale/about-us",
      "destination": "/:locale/",
      "statusCode": 301
    },
    {
      "source": "/:locale/about-us/(.*)",
      "destination": "/:locale/",
      "statusCode": 301
    },
    {
      "source": "/(de|es|fr|pt|ar|tr|ru|it|vi|id|ja|ko)/guides/(.*)",
      "destination": "/en/guides/$2",
      "statusCode": 308
    },
    {
      "source": "/(de|es|fr|pt|ar|tr|ru|it|vi|id|ja|ko)/guides",
      "destination": "/en/guides/",
      "statusCode": 308
    }
  ]
}
