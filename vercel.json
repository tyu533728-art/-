{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "natermanufacture.com" }],
      "destination": "https://www.natermanufacture.com/$1",
      "statusCode": 308
    },
    {
      "source": "/",
      "destination": "/en/",
      "statusCode": 308
    },
    {
      "source": "/:locale/products/mounted-spherical-roller-bearings",
      "destination": "/:locale/products/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/mounted-spherical-roller-bearings/(.*)",
      "destination": "/:locale/products/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/bearings",
      "destination": "/:locale/products/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/bearings/(.*)",
      "destination": "/:locale/products/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/bearing-housing",
      "destination": "/:locale/products/bearing-housing-series/",
      "statusCode": 301
    },
    {
      "source": "/:locale/products/bearing-housing/(.*)",
      "destination": "/:locale/products/bearing-housing-series/",
      "statusCode": 301
    },
    {
      "source": "/:locale/about-us",
      "destination": "/:locale/",
      "statusCode": 301
    },
    {
      "source": "/:locale/about-us/(.*)",
      "destination": "/:locale/",
      "statusCode": 301
    },
    {
      "source": "/(de|es|fr|pt|ar|tr|ru|it|vi|id|ja|ko)/guides/(.*)",
      "destination": "/en/guides/$2",
      "statusCode": 308
    },
    {
      "source": "/(de|es|fr|pt|ar|tr|ru|it|vi|id|ja|ko)/guides",
      "destination": "/en/guides/",
      "statusCode": 308
    }
  ]
}
